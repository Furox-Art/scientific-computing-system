      "function_signatures": [
        {
          "line": 10,
          "text": "function [simconf,evidence,ro] = readout(sim,params,params2,dv,dvstim,dvresp,opts)"
        }
      ],
      "relevant_lines": [
        {
          "line": 11,
          "text": "%readout simulate confidence based on evidence accumulation"
        },
        {
          "line": 22,
          "text": "%   - simconf: simulated confidence"
        },
        {
          "line": 24,
          "text": "%   - ro: raw confidence readout"
        },
        {
          "line": 37,
          "text": "alpha = itro - tro;"
        },
        {
          "line": 38,
          "text": "itro = min(max(itro,2),1000);"
        },
        {
          "line": 39,
          "text": "ro(sim.resp==1) = alpha*dvresp(itro,sim.resp==1) + (1-alpha)*dvresp(itro-1,sim.resp==1);"
        },
        {
          "line": 41,
          "text": "% for \"no\" response, confidence is based on a noise"
        },
        {
          "line": 51,
          "text": "% pass the evidence through a sigmoid to have 0 < confidence < 1"
        }
      ]
