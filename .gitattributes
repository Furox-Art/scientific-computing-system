# Linguist overrides for GitHub language statistics.
#
# Everything shipped as library code is Python. The files below are
# repository infrastructure rather than package source: index.js and
# bin/scs.js are the dependency-free npm launcher that forwards to
# `python -m cds`, npm.test.js is that launcher's contract test, paper.bib is
# the JOSS bibliography, .binder/postBuild configures the demo environment,
# and scripts/render_promo.mjs renders the promo image. They stay tracked but
# are excluded from the language bar, so the Languages panel reports the
# implementation language only: Python.

index.js                linguist-detectable=false
bin/scs.js              linguist-detectable=false
npm.test.js             linguist-detectable=false
scripts/render_promo.mjs linguist-detectable=false
paper.bib               linguist-detectable=false
.binder/postBuild       linguist-detectable=false

# Line-ending normalization. Normalize all text to LF in the repo so the
# same blob checks out identically on every platform; Git still hands the
# working copy the OS-preferred ending via core.autocrlf where configured.
# This prevents the "LF will be replaced by CRLF" warnings and the noisy
# whole-file diffs that pure line-ending flips cause.
* text=auto eol=lf

# Windows-only scripts keep their native CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never normalize, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.webm  binary
*.zip   binary
*.gz    binary
*.whl   binary
*.sqlite binary
